generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  vendeur
  admin
}

enum GameStatus {
  active
  paused
  finished
}

enum MoveRequestStatus {
  pending
  approved
  rejected
}

enum TaskStatus {
  todo
  doing
  done
}

enum IndicatorType {
  daily
  monthly
}

model User {
  id                String    @id @default(cuid())
  cuid              String    @unique // Format 4L+4D ex: LERN5042 — identifiant de connexion
  name              String
  password          String
  role              Role      @default(vendeur)
  color             String    // Hex assigné par un admin
  isFirstLogin      Boolean   @default(true)
  isHidden          Boolean   @default(false)
  lastLoginAt       DateTime?
  refreshTokenHash  String?   // SHA-256 du refresh token actif — null = aucune session active (P2-02)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  tasksCreated               Task[]                    @relation("TaskCreatedBy")
  tasksAssigned              Task[]                    @relation("TaskAssignee")
  dailySales                 DailySale[]
  monthlyTargets             MonthlyTarget[]
  monthlyWorkingDays         MonthlyWorkingDays[]
  teamNote                   TeamNote?
  gamePawns                  GamePawn[]
  moveRequests               MoveRequest[]
  gameWins                   Game[]                    @relation("GameWinner")

  @@map("users")
}

model Task {
  id              String     @id @default(cuid())
  title           String
  description     String?
  status          TaskStatus @default(todo)
  createdById     String?
  assigneeId      String?
  recurringTaskId String?
  // Ordre d'affichage repris du template récurrent au moment de la génération (voir
  // ensureTodayRecurringTaskInstancesExist) — null pour les tâches manuelles, qui n'ont pas d'ordre.
  order           Int?
  dueDate         DateTime?
  doneAt          DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  // createdBy est optionnel : une tâche générée depuis un template récurrent n'a pas de créateur humain
  createdBy     User?          @relation("TaskCreatedBy", fields: [createdById], references: [id])
  assignee      User?          @relation("TaskAssignee", fields: [assigneeId], references: [id])
  // Si le template est supprimé par un admin, les tâches déjà générées survivent, juste détachées
  recurringTask RecurringTask? @relation(fields: [recurringTaskId], references: [id], onDelete: SetNull)

  // Empêche de générer deux fois la même tâche pour le même jour pour le même template.
  // Postgres traite les NULL comme distincts, donc aucun impact sur les tâches manuelles (recurringTaskId = null).
  @@unique([recurringTaskId, dueDate])
  @@map("tasks")
}

model Indicator {
  id       String        @id @default(cuid())
  name     String        @unique
  type     IndicatorType @default(daily)
  order    Int
  isActive Boolean       @default(true)

  dailySales     DailySale[]
  monthlyTargets MonthlyTarget[]

  @@map("indicators")
}

model DailySale {
  id           String   @id @default(cuid())
  date         DateTime @db.Date
  userId       String
  indicatorId  String
  count        Float    @default(0)
  isCorrection Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user      User      @relation(fields: [userId], references: [id])
  indicator Indicator @relation(fields: [indicatorId], references: [id], onDelete: Cascade)

  @@unique([date, userId, indicatorId, isCorrection])
  @@map("daily_sales")
}

model MonthlyTarget {
  id          String   @id @default(cuid())
  month       Int
  year        Int
  userId      String
  indicatorId String
  target      Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User      @relation(fields: [userId], references: [id])
  indicator Indicator @relation(fields: [indicatorId], references: [id], onDelete: Cascade)

  @@unique([month, year, userId, indicatorId])
  @@map("monthly_targets")
}

model MonthlyWorkingDays {
  id          String   @id @default(cuid())
  month       Int
  year        Int
  userId      String
  workingDays Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@unique([month, year, userId])
  @@map("monthly_working_days")
}

model TeamNote {
  id          String   @id @default(cuid())
  userId      String   @unique
  publicNote  String?
  privateNote String?
  updatedAt   DateTime @updatedAt

  user       User            @relation(fields: [userId], references: [id])
  challenges TeamChallenge[]

  @@map("team_notes")
}

model Game {
  id         String     @id @default(cuid())
  floorCount Int
  objective  String     // Ce qu'il faut accomplir pour avancer d'un étage
  reward     String     // Récompense du gagnant
  status     GameStatus @default(active)
  winnerId   String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  pawns        GamePawn[]
  moveRequests MoveRequest[]
  winner       User?         @relation("GameWinner", fields: [winnerId], references: [id])

  @@map("games")
}

model GamePawn {
  id           String   @id @default(cuid())
  gameId       String
  userId       String
  currentFloor Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@unique([gameId, userId])
  @@map("game_pawns")
}

model MoveRequest {
  id        String            @id @default(cuid())
  gameId    String
  userId    String
  reason    String
  status    MoveRequestStatus @default(pending)
  adminNote String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@map("move_requests")
}

model RecurringTask {
  id             String   @id @default(cuid())
  title          String
  order          Int      @default(0)
  isActive       Boolean  @default(true)
  generatedTasks Task[]
  createdAt      DateTime @default(now())

  @@map("recurring_tasks")
}

model TeamChallenge {
  id        String   @id @default(cuid())
  noteId    String
  label     String
  current   String   @default("0")
  target    String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teamNote TeamNote @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@map("team_challenges")
}
