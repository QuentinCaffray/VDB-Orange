generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  vendeur
  admin
}

enum TaskStatus {
  todo
  doing
  done
}

enum IndicatorType {
  daily
  monthly
}

model User {
  id           String    @id @default(cuid())
  cuid         String    @unique // Format 4L+4D ex: LERN5042 — identifiant de connexion
  name         String
  password     String
  role         Role      @default(vendeur)
  color        String    // Hex assigné par un admin
  isFirstLogin Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tasksCreated   Task[]          @relation("TaskCreatedBy")
  tasksAssigned  Task[]          @relation("TaskAssignee")
  dailySales     DailySale[]
  monthlyTargets MonthlyTarget[]
  teamNote       TeamNote?

  @@map("users")
}

model Task {
  id          String     @id @default(cuid())
  title       String
  description String?
  status      TaskStatus @default(todo)
  createdById String
  assigneeId  String?
  dueDate     DateTime?
  doneAt      DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  createdBy User  @relation("TaskCreatedBy", fields: [createdById], references: [id])
  assignee  User? @relation("TaskAssignee", fields: [assigneeId], references: [id])

  @@map("tasks")
}

model Indicator {
  id       String        @id @default(cuid())
  name     String        @unique
  type     IndicatorType @default(daily)
  order    Int
  isActive Boolean       @default(true)

  dailySales     DailySale[]
  monthlyTargets MonthlyTarget[]

  @@map("indicators")
}

model DailySale {
  id           String   @id @default(cuid())
  date         DateTime @db.Date
  userId       String
  indicatorId  String
  count        Float    @default(0)
  isCorrection Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user      User      @relation(fields: [userId], references: [id])
  indicator Indicator @relation(fields: [indicatorId], references: [id], onDelete: Cascade)

  @@unique([date, userId, indicatorId, isCorrection])
  @@map("daily_sales")
}

model MonthlyTarget {
  id          String   @id @default(cuid())
  month       Int
  year        Int
  userId      String
  indicatorId String
  target      Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User      @relation(fields: [userId], references: [id])
  indicator Indicator @relation(fields: [indicatorId], references: [id], onDelete: Cascade)

  @@unique([month, year, userId, indicatorId])
  @@map("monthly_targets")
}

model TeamNote {
  id          String   @id @default(cuid())
  userId      String   @unique
  publicNote  String?
  privateNote String?
  updatedAt   DateTime @updatedAt

  user       User            @relation(fields: [userId], references: [id])
  challenges TeamChallenge[]

  @@map("team_notes")
}

model TeamChallenge {
  id        String   @id @default(cuid())
  noteId    String
  label     String
  current   String   @default("0")
  target    String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teamNote TeamNote @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@map("team_challenges")
}
